# Copy this file to .env and fill values locally.
# Never commit real credentials or authorization headers here.

API_KEY=
# Alternatively, the OpenAI SDK standard OPENAI_API_KEY is accepted as a fallback.
BASE_URL=

PRIMARY_MODEL=
FALLBACK_MODEL=
CODE_MODEL=
MLX_MODEL=
TOKENIZER_MODEL=

# Optional MCP endpoints. Local is attempted before remote.
MCP_LOCAL_URL=http://127.0.0.1:8000/mcp
MCP_REMOTE_URL=
MCP_REMOTE_TOKEN=

# Bundled MCP server bind address.
MCP_HOST=127.0.0.1
MCP_PORT=8000
